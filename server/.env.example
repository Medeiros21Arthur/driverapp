# Backend (Azure SQL Server)
PORT=3001
JWT_SECRET=troque-por-uma-frase-grande-e-secreta-aqui-123456

# Opção 1 — string de conexão completa (recomendado; pegue no portal do Azure)
AZURE_SQL_CONNECTION_STRING=Server=tcp:SEU_SERVIDOR.database.windows.net,1433;Database=SEU_BANCO;User Id=SEU_USUARIO;Password=SUA_SENHA;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# Opção 2 — configurar por partes (se não usar a string acima)
# AZURE_SQL_SERVER=SEU_SERVIDOR.database.windows.net
# AZURE_SQL_DATABASE=SEU_BANCO
# AZURE_SQL_USER=SEU_USUARIO
# AZURE_SQL_PASSWORD=SUA_SENHA
# AZURE_SQL_PORT=1433
# AZURE_SQL_ENCRYPT=true
# AZURE_SQL_TRUST_CERT=false